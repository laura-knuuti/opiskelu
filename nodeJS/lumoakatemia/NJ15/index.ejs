<!DOCTYPE html>
<html lang="en">
<body>
    <%- include('nav.ejs') %>
    <%- include('NJ15head.ejs') %>
    
<div class = "blogi sisalto">
    <h2>Kaikki blogit</h2>

    <% if (blogit.length > 0) { %>
    <% blogit.forEach (blog => { %>

        <h3 class = "title"><%= blog.title %></h3>
        <p class ="esittely"><%= blog.esittely %></p>

    <% }) %>
    <% } else { %>
        <p>Sivulla ei ole tällä hetkellä blogeja.</p>
   <% } %>
</div>
    <%- include('NJ15footer.ejs') %>
</body>
</html>